# Switchyard Change Fabric: example environment.
#
# Copy to .env (`cp .env.example .env`) and fill in locally. NEVER commit real
# secrets: .env and .dev.vars are gitignored. Cloudflare Worker secrets for
# `wrangler dev` belong in a gitignored .dev.vars file, not here.
#
# All values below are placeholders.

# --- Cloudflare account (for `wrangler login` / Artifacts) ---
# Usually set interactively via `npx wrangler login`; override here if needed.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# A scoped Cloudflare API token is an alternative to `wrangler login`: export it
# and wrangler authenticates non-interactively (useful for Artifacts and CI-less
# live runs). Needs Workers + Artifacts permissions on the account above. This is
# a placeholder; put the real token only in your gitignored .env, never here.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- Local console / worker dev ports ---
CONSOLE_PORT=8787

# --- Worker API token (optional) ---
# When the Worker's SWITCHYARD_API_TOKEN secret is set, every Node-side call to
# it (run-live, the CLI, the console launcher's runs) sends this same value as
# "authorization: Bearer <token>". Leave unset for an open local Worker.
# SWITCHYARD_API_TOKEN=

# --- Executor selection (one inference path; see README) ---
# One of: ai-gateway | workers-ai | noop (unset also means the offline noop stub).
# Any other value is an error.
EXECUTOR=ai-gateway

# --- ai-gateway (Cloudflare AI Gateway, BYOK) ---
# Run inference through a Cloudflare AI Gateway OpenAI-compatible endpoint. This
# is BYOK: the raw provider (OpenAI) key is stored IN THE CLOUDFLARE ACCOUNT and
# the gateway injects it; it NEVER lives here or in code. Only the gateway
# endpoint and the gateway credential go in your gitignored .env.
#
# The AI Gateway base URL, e.g.
# https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-name>
# The executor appends /openai/chat/completions.
CLOUDFLARE_AI_GATEWAY_URL=
# The AI Gateway credential, sent as `cf-aig-authorization: Bearer <token>`.
# This is NOT a raw provider key. Placeholder only; put the real value in .env.
CLOUDFLARE_AI_GATEWAY_TOKEN=
# Base model id for the first attempt. Defaults to gpt-4o-mini when left blank.
AI_GATEWAY_MODEL=gpt-4o
# The stronger model a verify-fail retry escalates to. Defaults to gpt-4o.
AI_GATEWAY_ESCALATION_MODELS=gpt-4.1,gpt-5
# Bounded retry rounds past the base round for the verify-fail ladder. Defaults
# to 3 when left blank. Each retry re-runs the implicated units on the escalation
# model fed the real failing gate evidence (a model id/number only, never a token).
AI_GATEWAY_MAX_MODEL_RETRIES=2
# The model each board agent turn runs on (run-board). Defaults to
# AI_GATEWAY_MODEL when left blank.
AI_GATEWAY_AGENT_MODEL=
# Completion-token ceilings, chosen per model. A reasoning model (gpt-5, the
# o-series) spends hidden reasoning tokens from this budget before it replies,
# so it gets a larger ceiling and an explicit reasoning_effort ("low" for an
# edit, "medium" for a plan). Leave blank for the defaults: edits 8192
# (reasoning 32768), plans 4096 (reasoning 16384). Positive integers only.
AI_GATEWAY_EXECUTOR_MAX_TOKENS=
AI_GATEWAY_EXECUTOR_REASONING_MAX_TOKENS=
AI_GATEWAY_PLANNER_MAX_TOKENS=
AI_GATEWAY_PLANNER_REASONING_MAX_TOKENS=

# --- Inference path for every model role (see docs/LOCAL-CLI.md) ---
# One of: gateway (default: the AI Gateway / EXECUTOR selection above) |
# claude-cli (the operator's own locally installed, logged-in Claude Code CLI:
# planner, agent turns, executor edits and escalation, tool authoring; EXECUTOR
# is ignored and the AI Gateway URL/token are not needed) | codex-cli (not
# supported yet). Any other value is an error. `--inference <mode>` on a live
# command overrides this.
# SWITCHYARD_INFERENCE=gateway
# claude-cli models (Claude Code aliases or full ids). Defaults shown.
# CLI_MODEL=sonnet
# CLI_ESCALATION_MODELS=opus
# CLI_PLANNER_MODEL=sonnet
# CLI_AGENT_MODEL=sonnet
# CLI_TOOL_MODELS=opus,sonnet
# The Claude Code binary (default `claude` on PATH) and the per-call timeout in ms.
# CLAUDE_CLI_BIN=claude
# CLI_TIMEOUT_MS=300000
# The advisory Jev layer is off in claude-cli mode; `gateway` keeps it on the AI
# Gateway (needs the gateway and account credentials above).
# CLI_JEV=off

# --- workers-ai ---
# Base model id for the Workers AI executor's first attempt (Cloudflare account
# only). Defaults to the llama-3.3-70b fast model when left blank. The
# chosen base model STAYS ATTACHED for the whole unit: a transient provider or
# transport error (a 5xx, a timeout, or a flaky stream) retries the SAME model
# rather than switching to a different one. If the first streaming attempt throws
# a transient error, the retry runs the same model WITHOUT streaming (a plain
# non-streaming request), so a persistently-flaky stream still yields that
# model's output; only the live token view is lost for that attempt. The only
# place the model deliberately changes is the verify-fail escalation below.
# Workers AI uses the account from CLOUDFLARE_ACCOUNT_ID and the scoped
# CLOUDFLARE_API_TOKEN above over the REST API (the local-runner path); nothing
# else is needed.

# Deprecated and unused. This used to name a different, cheaper model that ran
# when the base model call threw. That cross-model swap is removed: a transient
# error now retries the SAME base model (see above), so this value no longer
# changes which model does the work. The variable is still accepted so existing
# config does not error; you can safely leave it set or remove it.

# The stronger model a verify-fail retry escalates to: the base attempt runs
# WORKERS_AI_MODEL, and if the mechanical gate fails, one bounded retry runs this
# model fed the failing evidence. Defaults to glm-5.3 when left blank. This is a
# model id only, never a token.
