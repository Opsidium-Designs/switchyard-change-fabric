# Switchyard Change Fabric: example environment.
#
# Copy to .env (`cp .env.example .env`) and fill in locally. NEVER commit real
# secrets: .env and .dev.vars are gitignored. Cloudflare Worker secrets for
# `wrangler dev` belong in a gitignored apps/worker/.dev.vars file, not here.
#
# All values below are placeholders or examples. Where an uncommented line
# carries a value (for example AI_GATEWAY_MODEL=gpt-4o), that value is an
# EXAMPLE choice, not the code default; each comment names the default that
# applies when the variable is unset or blank.
#
# How it is read: the CLI reads this file into memory (never into its own
# process environment, so gates and agent-built tools cannot see a credential).
# `make dev`, `make dev-all`, `make deploy`, and the infra-* targets source it
# for wrangler and curl only. `make check`, `make demo`, and the offline board
# demos need none of it.

# =============================================================================
# Cloudflare account
# =============================================================================

# The account with Workers and Artifacts (beta). Needed for every live run
# (Artifacts and the Worker), whichever inference path you pick.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# A scoped Cloudflare API token (an alternative to `npx wrangler login`):
# Workers + Artifacts permissions on the account above (Queues too for
# `make infra-up` / `make artifacts-subscribe`). Placeholder only; put the real
# token in your gitignored .env, never here.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- Worker API token (optional locally, required before a deploy or a LAN) ---
# When the Worker's SWITCHYARD_API_TOKEN secret is set (`wrangler secret put`,
# or apps/worker/.dev.vars locally), every Node-side caller (run-live,
# run-board, the CLI, the console launcher's proxy) sends this same value as
# "authorization: Bearer <token>". Leave unset for an open local Worker: the
# local dev targets pass the Worker var SWITCHYARD_ALLOW_UNAUTHENTICATED=1 to
# `wrangler dev` (it is a Worker var, not read from this file; never set it on
# a deployed Worker).
# SWITCHYARD_API_TOKEN=

# =============================================================================
# Inference: which path every model role uses (see README "Inference options")
# =============================================================================

# One of: gateway (default) | claude-cli | codex-cli.
#   gateway     the AI Gateway (EXECUTOR and the gateway settings below).
#   claude-cli  the operator's own locally installed, logged-in Claude Code CLI
#               for the planner, agent turns, executor edits and escalation, and
#               tool authoring; EXECUTOR is ignored and no gateway URL/token is
#               needed (see docs/LOCAL-CLI.md and the local CLI section below).
#   codex-cli   the same, through the operator's own logged-in OpenAI Codex CLI
#               (`codex exec`, read-only sandbox; see docs/LOCAL-CLI.md "Codex").
# Any other value is an error. `--inference <mode>` on a live command wins.
# SWITCHYARD_INFERENCE=gateway

# =============================================================================
# Inference: AI Gateway (the default path)
# =============================================================================

# The executor selection: ai-gateway | workers-ai | noop. Unset means noop (the
# offline deterministic stub); any other value is an error. On this path only
# ai-gateway gives a live planner, live board agent turns, live tool
# authoring, and Jev; workers-ai is an executor only (see the Workers AI
# section). claude-cli ignores EXECUTOR.
EXECUTOR=ai-gateway

# BYOK: the provider (OpenAI) key is stored IN THE CLOUDFLARE ACCOUNT and the
# gateway injects it; it never lives here or in code. Only the gateway endpoint
# and the gateway credential go in your gitignored .env.
#
# The AI Gateway base URL, e.g.
# https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-name>
# The executor appends /openai/chat/completions.
CLOUDFLARE_AI_GATEWAY_URL=
# The AI Gateway credential, sent as `cf-aig-authorization: Bearer <token>`.
# This is NOT a raw provider key. Placeholder only; put the real value in .env.
CLOUDFLARE_AI_GATEWAY_TOKEN=

# The executor's base model for the first attempt. Default: gpt-4o-mini.
# (gpt-4o below is an example choice.)
AI_GATEWAY_MODEL=gpt-4o
# The planner's base model. Default: AI_GATEWAY_MODEL, then gpt-4o-mini.
# AI_GATEWAY_PLANNER_MODEL=
# The model each board agent turn runs on (run-board). Default:
# AI_GATEWAY_MODEL, then gpt-4o-mini.
AI_GATEWAY_AGENT_MODEL=

# The ORDERED verify-fail escalation ladder, comma separated: retry round 1
# uses the first model, round 2 the next, and so on (the planner reuses it for
# an invalid plan). Default: AI_GATEWAY_ESCALATION_MODEL, then gpt-4o.
# (gpt-4.1,gpt-5 below is an example choice.)
AI_GATEWAY_ESCALATION_MODELS=gpt-4.1,gpt-5
# Legacy singular form, read only when AI_GATEWAY_ESCALATION_MODELS is unset.
# AI_GATEWAY_ESCALATION_MODEL=gpt-4o

# Bounded retry rounds past the base round for the verify-fail ladder. Default:
# 3. (2 below is an example choice.) Each retry re-runs the implicated units on
# the next escalation model, fed the real failing gate evidence.
AI_GATEWAY_MAX_MODEL_RETRIES=2

# Completion-token ceilings, chosen per model. A reasoning model (gpt-5, the
# o-series) spends hidden reasoning tokens from this budget before it replies,
# so it gets a larger ceiling and an explicit reasoning_effort ("low" for an
# edit, "medium" for a plan). Positive integers only. Defaults when blank:
#   executor edits 8192 (reasoning models 32768)
#   plans          4096 (reasoning models 16384)
#   agent turns    2048 (reasoning models 16384)
AI_GATEWAY_EXECUTOR_MAX_TOKENS=
AI_GATEWAY_EXECUTOR_REASONING_MAX_TOKENS=
AI_GATEWAY_PLANNER_MAX_TOKENS=
AI_GATEWAY_PLANNER_REASONING_MAX_TOKENS=
# AI_GATEWAY_AGENT_MAX_TOKENS=

# =============================================================================
# Inference: local CLI (SWITCHYARD_INFERENCE=claude-cli; see docs/LOCAL-CLI.md)
# =============================================================================

# Models are Claude Code aliases (sonnet, opus, haiku) or full model ids for
# claude-cli, or Codex model ids for codex-cli (defaults there: gpt-5.5, with
# gpt-6.1-sol for escalation and tools). Claude defaults shown.
# CLI_MODEL=sonnet
# CLI_ESCALATION_MODELS=opus
# CLI_PLANNER_MODEL=sonnet
# CLI_AGENT_MODEL=sonnet
# CLI_TOOL_MODELS=opus,sonnet
# The Claude Code binary (default `claude` on PATH) and the per-call timeout in
# ms (default 300000; the call's process group is killed past it).
# CLAUDE_CLI_BIN=claude
# The Codex binary for codex-cli (default `codex` on PATH).
# CODEX_CLI_BIN=codex
# CLI_TIMEOUT_MS=300000
# The advisory Jev layer is off in CLI mode (default off); `gateway`
# keeps it on the AI Gateway (needs the gateway and account credentials above).
# CLI_JEV=off

# =============================================================================
# Workers AI (EXECUTOR=workers-ai: an executor only)
# =============================================================================

# Uses CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN above over the REST API;
# nothing else is needed. It provides the executor only: no live planner, no
# board agent turns, no Jev.
#
# The base model for the first attempt. Default:
# @cf/meta/llama-3.3-70b-instruct-fp8-fast. The base model STAYS ATTACHED for
# the whole unit: a transient provider or transport error (a 5xx, a timeout, or
# a flaky stream) retries the SAME model, the retry after a failed stream runs
# without streaming, and the only deliberate model change is the verify-fail
# escalation below.
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#
# The stronger model a verify-fail retry escalates to (fed the failing gate
# evidence). Default: @cf/qwen/qwen2.5-coder-32b-instruct.
# WORKERS_AI_ESCALATION_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
#
# run-live's verify-fail retry rounds, for any executor (`--max-model-retries`
# wins over it). Default: the executor's own budget (AI_GATEWAY_MAX_MODEL_RETRIES
# on the gateway), else 3.
# WORKERS_AI_MAX_MODEL_RETRIES=3
#
# Deprecated and unused: WORKERS_AI_FALLBACK_MODEL. It used to name a cheaper
# model that ran when the base model call threw; that cross-model swap is
# removed (a transient error retries the SAME base model), so this value no
# longer changes which model does the work. It is still accepted so existing
# config does not error; you can leave it set or remove it.
# WORKERS_AI_FALLBACK_MODEL=

# =============================================================================
# Jev (the advisory typed-decision layer; never decides a verdict)
# =============================================================================

# Live only with EXECUTOR=ai-gateway (or claude-cli with CLI_JEV=gateway), the
# gateway URL and token, and CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN.
# The gateway id that routes the decision call. Default: the gateway slug
# derived from CLOUDFLARE_AI_GATEWAY_URL.
# CF_AIG_GATEWAY_ID=
# The accept-when-confident threshold, clamped to 0..1. Default: 0.75.
# JEV_CONFIDENCE_THRESHOLD=0.75

# =============================================================================
# Local dev and console
# =============================================================================

# The local Worker (`make dev`, `make dev-all`). Read by apps/worker's dev
# script, so a value here applies through the Makefile's sourcing of .env.
# Defaults: 127.0.0.1, 8787, false. `make dev-all-lan` sets the IP to 0.0.0.0
# and `make dev-containers` enables containers (Docker required).
# WRANGLER_DEV_IP=127.0.0.1
# WRANGLER_DEV_PORT=8787
# WRANGLER_ENABLE_CONTAINERS=false
#
# The console runs on http://127.0.0.1:5173 (Vite; not configurable here).
# VITE_WORKER_URL is the Worker URL the console and its launcher use (default
# http://127.0.0.1:8787). It is read from the console's own process
# environment, not from this file: set it in the shell (`make dev-all-lan`
# sets it to this host's LAN address).
# VITE_WORKER_URL=http://127.0.0.1:8787

# =============================================================================
# Advanced
# =============================================================================

# Shell environment only (the CLI reads these from its own process
# environment, so a value in this file has no effect):
#   SCF_ENV_FILE   the env file the CLI reads instead of the repo's .env.
#   SCF_DEBUG      any value: the CLI prints the stack of an error (redacted).
# Set inside the gate container, not by an operator:
#   SCF_ACK_TIMEOUT_MS  how long an integration job waits for a phase
#                       acknowledgement (ms, default 120000).
#
# Script overrides: pass them in the shell or as `make VAR=...` (the infra-*
# and artifacts-subscribe targets also pick them up from this file, since they
# source it). Their defaults suit this repo:
#   CONSOLE_URL        tools/demo-live.sh's console URL (default http://127.0.0.1:5173)
#   WORKER             the Worker URL the Makefile and demo-live use (default http://127.0.0.1:8787)
#   QUEUE_NAME         the repo-pushed Queue (default switchyard-change-fabric-repo-pushed)
#   SUBSCRIPTION_NAME  the Artifacts subscription (default switchyard-change-fabric-repo-pushed)
#   WORKER_NAME        the hosted Worker (default switchyard-change-fabric)
#   NAMESPACE          the Artifacts namespace (default switchyard-change-fabric)
#   REPO_PREFIX        infra-down: only delete repos with this name prefix (default: all in the namespace)
#   API_BASE           the Cloudflare API base (default https://api.cloudflare.com/client/v4)
