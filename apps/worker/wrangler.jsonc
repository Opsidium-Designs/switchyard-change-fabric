{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchyard-change-fabric",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-23",
  // enable_ctx_exports: the GateRunner registers the GateEgress entrypoint as
  // the gate container's outbound HTTPS handler through ctx.exports.
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "observability": {
    "enabled": true
  },

  // Control-plane auth: the SWITCHYARD_API_TOKEN Worker SECRET. It is
  // deliberately NOT declared under "vars" (vars are plaintext in this file).
  // When set, every mutating route (and every route that returns a plaintext
  // Artifact token) requires `authorization: Bearer <token>`; read-only snapshot
  // GETs stay open. When unset, mutating routes are REFUSED (fail-closed)
  // unless the var SWITCHYARD_ALLOW_UNAUTHENTICATED=1 opts in: the local-dev
  // Makefile targets pass it to `wrangler dev` with --var; it is deliberately
  // not declared here, so a deploy never inherits it. Set the token out of
  // band, never in the repo:
  //   deploy:      npx wrangler secret put SWITCHYARD_API_TOKEN
  //   wrangler dev: SWITCHYARD_API_TOKEN=<value> in a gitignored apps/worker/.dev.vars
  // It is typed in src/env.ts; see src/auth.ts and docs/LIVE-DEPLOY.md.

  // Durable Object: single-owner serialized Change state + path/write leases.
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANGE_STATE",
        "class_name": "ChangeState"
      },
      // Integration on Cloudflare: owns one gate container per Change.
      {
        "name": "GATE_RUNNER",
        "class_name": "GateRunner"
      }
    ]
  },

  // SQLite-backed Durable Objects are the current default class type.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChangeState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GateRunner"]
    }
  ],

  // Workflow: durable, restartable Change work-graph lifecycle.
  "workflows": [
    {
      "name": "change-workflow",
      "binding": "CHANGE_WORKFLOW",
      "class_name": "ChangeWorkflow"
    },
    // Integration on Cloudflare: integrates a board's announced pushes, one
    // revision at a time per Change (see docs/BOARD.md).
    {
      "name": "integration-workflow",
      "binding": "INTEGRATION_WORKFLOW",
      "class_name": "IntegrationWorkflow"
    }
  ],

  // The integration gate container (Cloudflare Containers): node, git, and the
  // repo's verification package, driven over exec by the GateRunner. Built from
  // the repo root (the root .dockerignore admits only what the image copies).
  // It starts with internet access off; the GateRunner's egress handler relays
  // only what the job's current phase allows. Local `wrangler dev` builds it
  // with Docker; `make dev` turns containers off (see "dev" below).
  "containers": [
    {
      "class_name": "GateRunner",
      "image": "./containers/gate/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],

  // Cloudflare Artifacts binding: the M0 exit capability.
  //
  // `remote: true` proxies just this binding to the real Cloudflare Artifacts
  // service while the Worker/Workflow/DO run locally under `wrangler dev`,
  // giving a clone-and-run experience that still exercises real Artifacts.
  //
  // The `switchyard-change-fabric` namespace is created implicitly the first
  // time a repo is created under it (there is no separate `namespaces create`
  // command; see the README live-Artifacts notes). Authenticate first with
  // `wrangler login` or a CLOUDFLARE_API_TOKEN; no secrets are committed.
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "switchyard-change-fabric",
      "remote": true
    }
  ],

  // Event-driven recruitment nervous system.
  //
  // Cloudflare Artifacts event subscriptions deliver repo lifecycle events (the
  // `repo.pushed` event among them) to a Queue. This Worker consumes that queue
  // (the `queue` handler in src/index.ts), so an agent finishing a WorkUnit and
  // pushing to its own Artifact repo drives the next recruitment wave through a
  // real event, not a poll or a timer.
  //
  // The subscription itself is created out of band against the live account
  // (see `make artifacts-subscribe` / the README), pointed at this queue. The
  // offline test substrate drives the identical downstream path with a faked
  // event via `POST /events/repo-pushed`, so `make check` stays deterministic.
  "queues": {
    "consumers": [
      {
        "queue": "switchyard-change-fabric-repo-pushed",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
