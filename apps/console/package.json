{
  "name": "@switchyard-change/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:replay": "vite --mode replay",
    "build": "tsc --noEmit && vite build",
    "build:replay": "tsc --noEmit && vite build --mode replay",
    "preview": "vite preview",
    "preview:replay": "vite preview --mode replay",
    "export-replay": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/export-replay.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@switchyard-change/orchestration": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
